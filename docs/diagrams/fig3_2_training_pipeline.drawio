<mxfile host="app.diagrams.net">
  <diagram id="fig32" name="Fig 3.2 - Training pipeline">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="P1" value="&lt;b&gt;8 raw CICIDS2017 CSV files&lt;/b&gt;&lt;br&gt;(Kaggle mirror, data/raw/)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P2" value="&lt;b&gt;Data cleaning&lt;/b&gt;&lt;br&gt;normalise column names,&lt;br&gt;merge the 8 files" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P3" value="&lt;b&gt;Remove infinite / missing values&lt;/b&gt;&lt;br&gt;(2,867 rows dropped)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P4" value="&lt;b&gt;cicids2017_cleaned.csv&lt;/b&gt;&lt;br&gt;2,827,876 flows&lt;br&gt;78 features + label" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P5" value="&lt;b&gt;Binary target&lt;/b&gt;&lt;br&gt;BENIGN = 0&lt;br&gt;any attack type = 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="60" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="P6" value="&lt;b&gt;20% random sample&lt;/b&gt;&lt;br&gt;(fixed seed 42)&lt;br&gt;565,575 flows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P7" value="&lt;b&gt;Stratified 80/20 split&lt;/b&gt;&lt;br&gt;train: 452,460&lt;br&gt;test: 113,115" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="260" y="260" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P8" value="&lt;b&gt;Random Forest training&lt;/b&gt;&lt;br&gt;100 trees, max depth 20&lt;br&gt;(on training split)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="480" y="260" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P9" value="&lt;b&gt;Evaluation on held-out test split&lt;/b&gt;&lt;br&gt;Acc 99.86% | Prec 99.69%&lt;br&gt;Rec 99.58% | F1 99.63%" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P10" value="&lt;b&gt;rf_model.pkl&lt;/b&gt;&lt;br&gt;(12.4 MB model artefact)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="920" y="260" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="N1" value="Note: the dataset variant used contains no identifier columns (flow ID, source/destination IP, timestamp), so identifier-based leakage cannot occur in this pipeline (see Section 4.3)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1">
