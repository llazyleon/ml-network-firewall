<mxfile host="app.diagrams.net">
  <diagram id="fig33" name="Fig 3.3 - Runtime flow">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="n1" value="&lt;b&gt;Network flow arrives&lt;/b&gt;&lt;br&gt;Designed: live capture | Evaluated: replayed held-out flow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Feature vector (78 flow statistics)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="120" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;FlowClassifier.predict()&lt;/b&gt;&lt;br&gt;returns (label, confidence)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="250" y="210" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="Attack?" style="rhombus;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310" y="300" width="180" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="b1" value="Flow passes&lt;br&gt;(no enforcement action)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="POST /api/benign" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="20" y="430" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="&lt;b&gt;block_attack()&lt;/b&gt;&lt;br&gt;purge expired blocks, register new block&lt;br&gt;(source IP*, confidence, attack type, TTL 24 h)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="305" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="Apply iptables DROP rule&lt;br&gt;(sudo scoped to iptables only)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="425" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="Persist blocklist and metrics&lt;br&gt;to JSON (survives restarts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="525" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="POST /api/alert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="625" width="260" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="&lt;b&gt;FastAPI backend&lt;/b&gt;&lt;br&gt;updates counters and alert history (last 100)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="740" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="broadcast_update() over WebSocket /ws" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="840" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Dashboard updates live&lt;/b&gt;&lt;br&gt;(no manual refresh)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="250" y="930" width="300" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="note1" value="* Source IPs are synthetic placeholders: the dataset variant used contains no real IP addresses." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="305" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="Expiry is lazy: expired blocks are purged (and their iptables rules removed) the next time the enforcer is invoked, not by a background timer." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="410" width="290" height="90" as="geometry"/>
        </mxCell>

