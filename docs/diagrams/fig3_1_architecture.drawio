<mxfile host="app.diagrams.net">
  <diagram id="fig31" name="Fig 3.1 - Four-layer architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="L1" value="1. Intelligence Layer" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;swimlaneFillColor=#f7fbff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="L1a" value="CICIDS2017 dataset&lt;br&gt;(cleaned: 78 flow features + label)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L1">
          <mxGeometry x="20" y="54" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="L1b" value="Random Forest training&lt;br&gt;(100 trees, stratified train/test split)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="L1">
          <mxGeometry x="20" y="164" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="L1c" value="&lt;b&gt;rf_model.pkl&lt;/b&gt;&lt;br&gt;(trained model artefact)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="L1">
          <mxGeometry x="20" y="274" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="L2" value="2. Detection Layer" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;swimlaneFillColor=#f6fbf5;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="300" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="L2a" value="&lt;b&gt;Flow source&lt;/b&gt;&lt;br&gt;Designed: live packet capture (Scapy)&lt;br&gt;Evaluated: replay of held-out CICIDS2017 test flows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="L2">
