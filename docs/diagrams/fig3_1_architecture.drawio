        <mxCell id="L3" value="3. Enforcement Layer" style="swimlane;whiteSpace=wrap;html=1;startSize=34;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;swimlaneFillColor=#fdf6f6;" vertex="1" parent="1">
